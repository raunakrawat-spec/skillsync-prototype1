# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on
PORT=4000

# Secret used to sign JWT auth tokens - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# SQLite database file (created automatically on first run)
DB_FILE=./skillsync.db

# Comma separated list of origins allowed to call this API from the browser.
# Use * only for local development.
CORS_ORIGIN=*

# OPTIONAL: Anthropic API key. If set, the roadmap generator and the Q&A
# chatbot will call Claude to write a richer, personalised, day/week-wise
# plan and answer questions. If left blank, the app automatically falls
# back to the built-in rule-based engine so everything still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
